APP_NAME=TindaTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Local `php artisan serve` only (Railway runs a real web server). With 1 worker a basket
# scan waiting on Gemini blocks the phone's polling and every other request. The root
# `npm run dev` / `dev:lan` scripts already pass 4. (Not supported by PHP on Windows.)
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tindatrack
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# React app (single URL, used for password-reset links)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional regex patterns, e.g. Vercel preview URLs (no commas inside)
CORS_ALLOWED_ORIGIN_PATTERNS=

SANCTUM_TOKEN_EXPIRATION=10080

# System Integration API (CIT 305) - shared secret used by TindaOrder (System 1)
# Sent by the client in the X-API-Key header. Use the same value in ordering-system/config.php
INTEGRATION_API_KEY=tt_live_cit305_demo_key_change_me

# Open Food Facts Product Lookup
PRODUCT_LOOKUP_ENABLED=true
OFF_USER_AGENT="TindaTrack/1.1 (your-email@example.com)"
OFF_TIMEOUT=5

# Optional Realtime Broadcasting (Pusher)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# AI Vision & Basket Scan (v2.0)
# Provider: 'gemini' | 'mock' (defaults to 'gemini' if GEMINI_API_KEY is present, else 'mock')
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT=30
# v2.3 speed: short primary timeout + one fallback (worst case ≈ 27 s, was 60 s)
AI_PRIMARY_TIMEOUT=12
AI_FALLBACK_TIMEOUT=15
# Gemini thinking: minimal | low | medium | high | none (3.x → thinking_level, 2.x → thinking_budget)
GEMINI_THINKING_LEVEL=minimal
# Image tokens: MEDIA_RESOLUTION_LOW | MEDIA_RESOLUTION_MEDIUM | MEDIA_RESOLUTION_HIGH | none
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
AI_MAX_OUTPUT_TOKENS=2048
# Above this many active products the basket prompt only lists products with a photo or a recent sale
AI_CATALOG_FOCUS_THRESHOLD=150
AI_PER_USER_PER_MINUTE=6
AI_DAILY_LIMIT=500
AI_MAX_IMAGE_KB=5120
AI_SAVE_SCAN_IMAGES=false

# Production environment notes (e.g. Railway):
# APP_ENV=production
# APP_DEBUG=false
# APP_TIMEZONE=Asia/Manila
# LOG_CHANNEL=stderr
# DEMO_HISTORY_DAYS=60

