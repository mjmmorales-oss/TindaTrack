# Production Environment Variables for Vercel
# Point to your deployed Railway backend URL
VITE_API_URL=https://YOUR-API.up.railway.app/api
VITE_APP_NAME=TindaTrack
# Demo account helper is strictly dev-only (production builds always hide it regardless)
VITE_SHOW_DEMO_ACCOUNTS=false

# Data Source: 'api' uses the real Laravel backend, 'mock' uses in-memory mock fallback
VITE_DATA_SOURCE=api

# Optional: mock latency in milliseconds when VITE_DATA_SOURCE=mock
# VITE_MOCK_LATENCY=200
