# TindaTrack Frontend Environment Variables Example

# API Base URL (leave empty or use /api when running dev:lan with Vite proxy)
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=TindaTrack

# Data Source: 'api' uses the real Laravel backend, 'mock' uses in-memory mock fallback
VITE_DATA_SOURCE=api

# Demo account buttons (strictly dev-only, hidden in production builds)
VITE_SHOW_DEMO_ACCOUNTS=true

# Optional mock latency in milliseconds when VITE_DATA_SOURCE=mock
VITE_MOCK_LATENCY=200

# Barcode Scanning & Realtime Settings
# Realtime driver: 'polling' (default) or 'pusher'
VITE_REALTIME_DRIVER=polling

# Public URL used in QR codes for phone pairing (e.g., https://your-app.vercel.app or https://192.168.1.5:5173)
# If blank, defaults to window.location.origin
VITE_PUBLIC_APP_URL=

# Pusher credentials (optional upgrade, only needed if VITE_REALTIME_DRIVER=pusher)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
