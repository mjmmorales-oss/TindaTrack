{
  "name": "tindatrack",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:lan": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web:lan\"",
    "dev:api": "cd backend && php artisan serve",
    "dev:web": "npm --prefix frontend run dev",
    "dev:web:lan": "npm --prefix frontend run dev:lan",
    "build:web": "npm --prefix frontend run build",
    "smoke:pairing": "node scripts/smoke-pairing.mjs",
    "smoke:prod": "node scripts/smoke-prod-like.mjs",
    "check:bundle": "node scripts/check-prod-bundle.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:mobile": "node frontend/scripts/check-mobile.mjs",
    "gen:demo-art": "npm --prefix frontend run gen:demo-art",
    "gen:icons": "npm --prefix frontend run gen:icons"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
