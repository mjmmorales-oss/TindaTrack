{
  "info": {
    "name": "CIT305 TindaOrder ↔ TindaTrack Integration Tests",
    "description": "Integration test cases for System 1 (TindaOrder Online Ordering) → System 2 (TindaTrack Inventory) REST API. Run TindaTrack first (php artisan serve). Run the whole collection with the Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-01 Valid order is accepted (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders"
          ]
        },
        "description": "System 1 sends order_id, customer_id, product_id, quantity. System 2 deducts stock and returns product_id, available_quantity, stock_status.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"customer_id\": \"CUST-001\",\n  \"items\": [\n    {\n      \"product_id\": 4,\n      \"quantity\": 2\n    },\n    {\n      \"product_id\": 1,\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('order_id', 'ORD-PM-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('Order accepted', () => pm.expect(b.status).to.eql('accepted'));",
              "pm.test('Returns product_id, available_quantity, stock_status', () => {",
              "  b.items.forEach(i => { pm.expect(i).to.have.property('product_id'); pm.expect(i).to.have.property('available_quantity'); pm.expect(i).to.have.property('stock_status'); });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-02 Insufficient stock is rejected (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{reject_order_id}}\",\n  \"customer_id\": \"CUST-002\",\n  \"items\": [\n    {\n      \"product_id\": 4,\n      \"quantity\": 1\n    },\n    {\n      \"product_id\": 7,\n      \"quantity\": 999\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('reject_order_id', 'ORD-PM-REJ-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
              "const b = pm.response.json();",
              "pm.test('Order rejected', () => pm.expect(b.status).to.eql('rejected'));",
              "pm.test('Item flagged insufficient_stock', () => pm.expect(b.items[1].stock_status).to.eql('insufficient_stock'));"
            ]
          }
        }
      ]
    },
