    {
      "name": "TC-08b Duplicate order - same order_id again (200, not deducted twice)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{dup_order_id}}\",\n  \"customer_id\": \"CUST-003\",\n  \"items\": [\n    {\n      \"product_id\": 12,\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Second send is 200 OK (replay)', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('Marked as duplicate', () => pm.expect(b.duplicate).to.eql(true));",
              "pm.test('Stock not deducted twice', () => pm.expect(b.items[0].available_quantity).to.eql(Number(pm.collectionVariables.get('dup_stock_after'))));"
            ]
          }
        }
      ]
