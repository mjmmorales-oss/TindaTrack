          "mode": "raw",
          "raw": "{\n  \"order_id\": \"{{dup_order_id}}\",\n  \"customer_id\": \"CUST-003\",\n  \"items\": [\n    {\n      \"product_id\": 12,\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
