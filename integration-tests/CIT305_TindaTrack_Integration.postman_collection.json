    {
      "name": "TC-10 Stock check as XML (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/4/stock?format=xml",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "4",
            "stock"
          ],
          "query": [
            {
              "key": "format",
              "value": "xml"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is XML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/xml'));",
              "const t = pm.response.text();",
              "pm.test('XML has ProductID, AvailableQuantity, StockStatus', () => { pm.expect(t).to.include('<ProductID>4</ProductID>'); pm.expect(t).to.match(/<AvailableQuantity>\\d+<\\/AvailableQuantity>/); pm.expect(t).to.match(/<StockStatus>(in_stock|low_stock|out_of_stock)<\\/StockStatus>/); });"
            ]
          }
        }
      ]
    },
