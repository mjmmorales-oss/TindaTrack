            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('First send is 201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('dup_stock_after', pm.response.json().items[0].available_quantity);"
            ]
          }
        }
      ]
